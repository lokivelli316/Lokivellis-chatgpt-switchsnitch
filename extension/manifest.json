{
  "manifest_version": 3,
  "name": "Lokivelli's ChatGPT SwitchSnitch",
  "version": "0.2.1",
  "description": "Authenticated, receipted detection of unexpected ChatGPT model changes with explicit operator decisions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SwitchSnitch"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
